# Separate public repo (github.com/Vazirified/live-tickers). Never absorb it here.
# OBS loads it over http://localhost:5000, so its location does not matter.
Scripts/live-tickers-v.2.0/

# Third-party plugin installers. Download sources are listed in README.
Extensions/

# Installers downloaded by install.ps1 (pinned versions, SHA-256 checked)
installers/

# YouTube Audio Library tracks: licensed for use in our videos/streams,
# not for redistribution as files. Titles and artists are listed in README.
VazirifiedFX-dual-output-scene/resources/live-session-music/
*.mp3
*.wav

# Third-party files the installer handles instead (see README):
# Audio Transition script by dqm, downloaded from the OBS forum (no license to share it),
# and the IRZar font, a recommended install.
Scripts/audio-transition.lua
Scripts/audio-transition.lua.before-install-*
Fonts/IRZar.ttf

# OBS auto-backups (git history replaces them)
*.bak

# Windows clutter
Thumbs.db
desktop.ini
